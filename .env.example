# OpenClipnest settings.
#
#   cp .env.example .env      then fill in .env (not this file)
#   docker compose up -d --build
#
# docker-compose.yml reads .env from the same folder. .env is never committed
# (see .gitignore), so `git pull` does not conflict with your settings. Keep a
# copy of .env somewhere other than this machine: it holds the key your
# recordings are encrypted with.
#
# Write every value as NAME='value'. Inside single quotes everything is taken
# literally, including $ and #. Without quotes Docker Compose expands $NAME,
# so a password like Pa$sword1234 would silently turn into "Pa". A value
# cannot contain a single quote itself.

# ── Your account ─────────────────────────────────────────────────────────────
# The one account of this install, created on the first start. The password
# needs 12+ characters with an upper-case letter, a lower-case letter and a
# digit. It is applied again on every start: to change it, edit it here and
# run `docker compose up -d` (this signs out every device). The e-mail cannot
# be changed after the first start.
ACCOUNT_EMAIL=''
ACCOUNT_PASSWORD=''

# ── Addresses ────────────────────────────────────────────────────────────────
# Where you open the web app, without a trailing slash, e.g.
# 'http://192.168.1.10:8080'. With HTTPS (see below) or behind a TLS reverse
# proxy of your own: the https:// address, e.g. 'https://clips.example.com'.
PUBLIC_URL=''

# The address CAMERAS use to reach this machine: an IP or host name, no
# scheme, e.g. '192.168.1.10'. FTP passive mode hands it to the camera, so it
# must be reachable from the camera — never 'localhost'.
FTP_HOST=''

# ── Disk limit (optional) ────────────────────────────────────────────────────
# Cap on the space recordings may use: '500GB', '2TB', '750GiB'. Empty = no
# limit. With "delete oldest when full" enabled in the app the oldest
# recordings make room for new ones; otherwise uploads are refused once the
# limit is reached.
DISK_LIMIT=''

# ── Secrets ──────────────────────────────────────────────────────────────────
# You define them; nothing is generated for you, and the server refuses to
# start while one is missing. Fill all four empty ones at once with this
# command, run next to .env (it never replaces a value that is already set):
#
#   for n in ENCRYPTION_KEY TOKEN_SECRET DATABASE_PASSWORD STORAGE_PASSWORD; do sed -i.bak "s/^$n=''\$/$n='$(openssl rand -hex 32)'/" .env; done; rm -f .env.bak
#
# or generate each one by hand with `openssl rand -hex 32`.
#
# BACK UP ENCRYPTION_KEY. Every recording is encrypted with a key derived
# from it. If it is lost, the recordings cannot be recovered — by anyone. It
# can never be changed. What changing the others does: README.md, "Secrets".
ENCRYPTION_KEY=''
TOKEN_SECRET=''
DATABASE_PASSWORD=''
STORAGE_PASSWORD=''
STORAGE_USER='clipnest'

# ── Push notifications to the phone apps (optional) ──────────────────────────
# Delivered to the iOS and Android apps through the Clipnest push relay, which
# only ever sees encrypted messages; this server registers itself there
# automatically. To turn push on: 'https://push.clipnest.video'. Empty = no
# push (the apps still show notifications inside the app).
PUSH_RELAY_URL=''

# ── What runs: object storage and HTTPS ──────────────────────────────────────
# A comma-separated list. Keep the line even when it is empty.
#   bundled-storage  runs the bundled MinIO and keeps recordings on this
#                    machine. Leave it out to use your own S3-compatible
#                    storage, and fill in the STORAGE_* lines further down.
#   https            automatic HTTPS, see the next section.
# For example: 'bundled-storage'   'bundled-storage,https'   ''   'https'
COMPOSE_PROFILES='bundled-storage'

# ── HTTPS (optional) ─────────────────────────────────────────────────────────
# A free certificate from Let's Encrypt for your own domain, renewed by itself,
# for the web app, the phone and desktop apps and MCP. You need:
#   - a domain name, such as clips.example.com, that points at this machine's
#     public address (a dynamic-DNS name works too);
#   - ports 80 and 443 of this machine reachable from the internet. Port 80 is
#     how Let's Encrypt checks that the domain is yours; it also sends
#     http:// to https://.
# Then, in this file:
#   1. set PUBLIC_URL (above) to 'https://clips.example.com': your domain,
#      with https://, no port and no path;
#   2. add ,https to COMPOSE_PROFILES (above), as in 'bundled-storage,https',
#      or just 'https' with your own object storage;
#   3. run `docker compose up -d`.
# Optional: WEB_PORT='127.0.0.1:8080' (below) makes plain HTTP reachable from
# this machine only.

# ── Optional ─────────────────────────────────────────────────────────────────
# Host port of the web app (default 8080). '127.0.0.1:8080' makes it reachable
# from this machine only, e.g. behind a reverse proxy on the same host.
#WEB_PORT='8080'

# Host port cameras connect to for FTP/FTPS (default 21). The passive data
# ports 30000-30099 stay as they are.
#FTP_PORT='21'

# Where the bundled storage keeps its data: a named Docker volume by default,
# or an absolute host path such as '/srv/clipnest' (or one starting with ./).
# Set it before the first start; README.md explains how to move existing data.
#RECORDINGS_DIR='/srv/clipnest'

# ── Your own object storage (only with COMPOSE_PROFILES='') ──────────────────
# Any S3-compatible store that supports SSE-C (encryption with keys supplied
# by the client) over HTTPS. STORAGE_USER / STORAGE_PASSWORD above become its
# access key and secret key. Create the three buckets yourself. See README.md,
# "Your own object storage", for the full list of requirements.
#STORAGE_ENDPOINT='https://s3.example.com'
#STORAGE_RECORDINGS_BUCKET='recordings'
#STORAGE_THUMBNAILS_BUCKET='thumbnails'
#STORAGE_SIDECARS_BUCKET='sidecars'
# Certificates trusted for STORAGE_ENDPOINT, as a path inside the containers.
# For a publicly trusted certificate use the system list:
#STORAGE_CA_BUNDLE='/etc/ssl/certs/ca-certificates.crt'
